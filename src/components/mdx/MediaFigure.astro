---
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  type?: 'image' | 'gif' | 'video';
  poster?: string;
  credit?: string;
}

const { src, alt, caption, type, poster, credit } = Astro.props;

let mediaType = type;
if (!mediaType) {
  if (src.endsWith('.mp4') || src.endsWith('.webm')) mediaType = 'video';
  else if (src.includes('youtube.com') || src.includes('youtu.be')) mediaType = 'video';
  else if (src.endsWith('.gif')) mediaType = 'gif';
  else mediaType = 'image';
}

const isYouTube = src.includes('youtube.com') || src.includes('youtu.be');
let youtubeUrl = src;
if (isYouTube) {
  const videoId = src.includes('youtu.be') ? src.split('/').pop() : new URL(src).searchParams.get('v');
  youtubeUrl = `https://www.youtube-nocookie.com/embed/${videoId}`;
}
---
<figure class="media-figure" style="margin: 2rem 0; text-align: center;">
  {mediaType === 'image' || mediaType === 'gif' ? (
    <>
      <img src={src} alt={alt} loading="lazy" style="max-width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--color-border);" />
      <div style="margin-top: 0.5rem; font-size: 0.875rem;">
        <a href={src} target="_blank" rel="noopener">Open full-size media (opens in a new tab)</a>
      </div>
    </>
  ) : isYouTube ? (
    <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
      <iframe src={youtubeUrl} title={alt} frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></iframe>
    </div>
  ) : (
    <video controls playsinline preload="metadata" poster={poster} style="max-width: 100%; border-radius: 8px;">
      <source src={src} />
      {alt}
    </video>
  )}
  {caption && <figcaption style="margin-top: 0.5rem; font-size: 0.875rem; color: var(--color-text-secondary);">{caption}</figcaption>}
  {credit && <div style="font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 0.25rem;">Credit: {credit}</div>}
</figure>
